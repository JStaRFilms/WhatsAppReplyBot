# Backend only. Never put this key in EXPO_PUBLIC variables or the mobile app.
OPENROUTER_API_KEY=
# Request hidden attribution. Replace with your own app URL.
OPENROUTER_APP_NAME=Otherme
OPENROUTER_APP_URL=http://localhost:8081
# FFmpeg must be on PATH for live images, stickers and GIFs. Optional exact executable:
# FFMPEG_PATH=C:/tools/ffmpeg/ffmpeg.exe
# Starting the normal demo command does not enable remote calls.
# Use the explicit backend openrouter command, then enable consent in Settings.
