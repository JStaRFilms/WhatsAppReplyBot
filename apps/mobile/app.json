{
  "expo": {
    "name": "Otherme",
    "slug": "whatsapp-reply-bot",
    "scheme": "replybot",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      ["expo-audio", {"microphonePermission": "Allow Otherme to record voice notes you choose to send.", "enableBackgroundRecording": false, "enableBackgroundPlayback": false}]
    ],
    "web": {
      "bundler": "metro",
      "output": "single"
    }
  }
}
