{
  "name": "whatsapp-reply-bot",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "pnpm --filter @replybot/core test && pnpm --filter @replybot/backend test && pnpm --filter @replybot/mobile test",
    "typecheck": "pnpm -r typecheck",
    "backend": "pnpm --filter @replybot/backend dev",
    "backend:openrouter": "pnpm --filter @replybot/backend openrouter",
    "backend:live": "pnpm --filter @replybot/backend live",
    "mobile": "pnpm --filter @replybot/mobile start",
    "mobile:web": "pnpm --filter @replybot/mobile web"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "playwright": "^1.64.0",
    "tsx": "^4.21.0",
    "typescript": "5.9.3"
  }
}
